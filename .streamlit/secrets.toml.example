# ──────────────────────────────────────────────────────────────────────────────
# Ejemplo de secretos para Streamlit  →  copiar como secrets.toml y completar
# En Streamlit Cloud: Settings > Secrets > pegar este bloque con valores reales
# ──────────────────────────────────────────────────────────────────────────────

# Conexión a Supabase (PostgreSQL)
# Obtén la cadena en: Supabase > Project > Settings > Database > Connection string
DATABASE_URL = "postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# OpenAI — Clasificación inteligente de ítems de factura
# Obtén tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY = "sk-..."
