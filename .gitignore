# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Logs and local runtime files
*.log
migrate_log.txt

# Local environment files
.env
.env.*
!.env.example

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local data databases
/data/*.db
/data/*.sqlite
/data/*.sqlite3
/data/*.sqlite3-*

# Docker override files
Dockerfile.*.local
docker-compose.override.yml

# Temporary exports and generated spreadsheets
*.xlsx
*.xls
*.xlsm
*.csv
# Excepción: datos de referencia geográfica necesarios para seed en producción
!0111 paises.xlsx

# Next.js build artifacts
frontend/.next/

# Notas de planificación en la raíz (archivos con prefijos numéricos o #)
/[0-9]*.md
/\#*.md

# Keep source code and project config only
# (remove patterns above if you need to version specific data files)
