# Copia este archivo como .env y completa los valores
# cp .env.example .env   (Linux/Mac)
# copy .env.example .env (Windows)

# ── PostgreSQL local (Docker) ──────────────────────────────────────────────
POSTGRES_USER=siigo
POSTGRES_PASSWORD=siigo_pass
POSTGRES_DB=siigo_db

# URL de conexión a PostgreSQL (usada por FastAPI/Alembic)
DATABASE_URL=postgresql+psycopg2://siigo:siigo_pass@localhost:5432/siigo_db

# ── FastAPI ────────────────────────────────────────────────────────────────
# Frontend(s) permitidos para CORS del API (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# OpenAI — Clasificación inteligente de ítems de factura (opcional)
OPENAI_API_KEY=sk-...

# ── Supabase (Auth) ────────────────────────────────────────────────────────
# Obtenlos en: https://supabase.com/dashboard -> tu proyecto -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret para que FastAPI valide tokens de Supabase
# Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=super-secret-jwt-token...

# ── Next.js ────────────────────────────────────────────────────────────────
# En Docker: apunta al contenedor api. En Vercel: URL de Render.
NEXT_PUBLIC_API_URL=http://localhost:8000
