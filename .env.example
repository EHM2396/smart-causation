# Copia este archivo como .env y completa los valores
# cp .env.example .env

# URL de conexión a PostgreSQL
# Formato: postgresql+psycopg2://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/siigo_db

# Frontend(s) permitidos para CORS del API (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# URL del API (usada por clientes externos o futuras integraciones)
API_URL=http://localhost:8000

# OpenAI — Clasificación inteligente de ítems de factura (opcional)
# Si no se configura, la plataforma funciona igual sin IA
OPENAI_API_KEY=sk-...

# ── Correo transaccional (Gmail SMTP) ─────────────────────────────────────────
# Crear una cuenta Gmail dedicada y generar una App Password:
# Google Account → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones
EMAIL_ENABLED=true
MAIL_USERNAME=noreply.ciolix@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=noreply.ciolix@gmail.com
MAIL_FROM_NAME=Ciolix
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_TLS=true
MAIL_SSL=false

# URL pública del frontend (usada en los enlaces de los correos)
FRONTEND_URL=https://tudominio.com
