# Copia este archivo como .env y completa los valores
# cp .env.example .env

# URL de conexión a PostgreSQL
# Formato: postgresql+psycopg2://usuario:contraseña@host:puerto/nombre_bd
# En Supabase agrega ?sslmode=require al final.
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/siigo_db

# Frontend(s) permitidos para CORS del API (separados por coma)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# URL del API (usada por clientes externos o futuras integraciones)
API_URL=http://localhost:8000

# OpenAI — Clasificación inteligente de ítems de factura (opcional)
# Si no se configura, la plataforma funciona igual sin IA
OPENAI_API_KEY=sk-...

# ── Correo transaccional (Hostinger SMTP) ─────────────────────────────────────
# Crear la cuenta en: Hostinger hPanel → Emails → Cuentas de correo
# Usar: noreply@smartcausacion.com (o el dominio que configures)
MAIL_USERNAME=noreply@tudominio.com
MAIL_PASSWORD=contraseña_de_la_cuenta_hostinger
MAIL_FROM=noreply@tudominio.com
MAIL_FROM_NAME=Smart Causación
MAIL_SERVER=smtp.hostinger.com
MAIL_PORT=587
MAIL_TLS=true
MAIL_SSL=false

# URL pública del frontend (usada en los enlaces de los correos)
FRONTEND_URL=https://smart-causation-52ig.vercel.app
